{
  "name": "@p1lab/vflow",
  "version": "2.1.0",
  "description": "提案驱动 AI 研发工作流引擎",
  "type": "module",
  "bin": {
    "vflow": "src/cli.mjs"
  },
  "files": [
    "scripts/build-template.mjs",
    "src/cli.mjs",
    "src/detect.mjs",
