{
  "$schema": "./schema.json",
  "id": "t2-standard",
  "name": "T2 Standard Task",
  "version": "2.0.0",
  "description": "Standard T2 task pipeline with ralph step execution",
  "entry": "plan_req",
  "defaults": {
    "max_visits": 10,
    "timeout_ms": 600000
  },
  "inputs": {
    "description": {
      "type": "string",
      "required": true,
      "description": "Task description / user intent"
    }
  },
  "nodes": {
    "plan_req": {
      "type": "command",
      "cmd": "vflow-plan-req",
      "skill_ref": "vflow-task",
      "description": "Fill task-spec.md §1 requirements and §2 R-ID acceptance entries",
      "required_reading": [
        "@task/task-spec.md",
        "@.vflow/knowledge.md"
      ],
      "completion_checks": ["has_rids"],
      "next": "gate_req"
    },
    "gate_req": {
      "type": "gate",
      "condition": "true",
      "on_pass": "plan_design",
      "on_fail": "plan_req",
      "wait": true,
      "wait_message": "Gate 1: Confirm R-IDs in task-spec.md §2. Reply to continue."
    },
    "plan_design": {
      "type": "command",
      "cmd": "vflow-plan-design",
      "skill_ref": "vflow-task",
      "description": "Fill task-spec.md §3 design, §4 change list, §5 spec refs, §6 task checklist",
      "required_reading": [
        "@task/task-spec.md",
        "@.vflow/knowledge.md"
      ],
      "completion_checks": ["has_checklist", "rids_covered"],
      "next": "eval_risk"
    },
    "eval_risk": {
      "type": "decision",
      "strategy": "expr",
      "eval": "ctx.var.risk || 'low'",
      "edges": [
        {
          "value": "high",
          "target": "gate_design",
          "description": "High-risk tasks need explicit design approval"
        },
        {
          "default": true,
          "target": "implement",
          "description": "Low-risk tasks proceed directly to implementation"
        }
      ]
    },
    "gate_design": {
      "type": "gate",
      "condition": "true",
      "on_pass": "implement",
      "on_fail": "plan_design",
      "wait": true,
      "wait_message": "Gate 2: High-risk task — review design in task-spec.md §3-§6 before proceeding."
    },
    "implement": {
      "type": "command",
      "cmd": "vflow-implement",
      "skill_ref": "vflow-code",
      "description": "Implement changes per task-spec.md §6 checklist. Log changes in ledger.md §1.",
      "required_reading": [
        "@task/task-spec.md",
        "@task/ledger.md"
      ],
      "completion_checks": ["has_ledger_entries", "checklist_checked"],
      "next": "verify"
    },
    "verify": {
      "type": "command",
      "cmd": "vflow-verify",
      "skill_ref": "vflow-review",
      "description": "Run tests, fill ledger.md §4 verification results per R-ID",
      "required_reading": [
        "@task/task-spec.md",
        "@task/ledger.md"
      ],
      "completion_checks": ["has_rid_closure"],
      "next": "gate_accept"
    },
    "gate_accept": {
      "type": "gate",
      "condition": "true",
      "on_pass": "spec_writeback",
      "on_fail": "implement",
      "wait": true,
      "wait_message": "Gate 3: Verify all tests pass and all R-IDs have verification entries in ledger.md §4."
    },
    "spec_writeback": {
      "type": "command",
      "cmd": "vflow-spec-writeback",
      "skill_ref": "vflow-spec",
      "description": "Write back learnings to spec/ and update knowledge.md",
      "required_reading": [
        "@task/ledger.md",
        "@.vflow/knowledge.md"
      ],
      "completion_checks": ["has_knowledge_update"],
      "next": "done"
    },
    "done": {
      "type": "terminal",
      "status": "success",
      "summary": "Task completed. All R-IDs verified and specs updated."
    }
  }
}
